  m_Script: {fileID: 11500000, guid: 83d8dc95367574b6eb839c02d540da0a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 557439075}
  continueButton: {fileID: 1481410974}
  blackoutImage: {fileID: 1352425287}
  dialogueImages:
  - {fileID: 79517394}
  - {fileID: 1374558775}
  - {fileID: 1412090691}
  - {fileID: 172612185}
  dialogues:
  - "As a radiologist, I\u2019m used to keeping up a fast pace\u2026 maybe a quick
    5 minute nap won't hurt\u2026"
  - "Wait\u2026 how long was I out for...? Wait, something's not right. Why does
    the air feel so dense all of a sudden?"
  - "This can't be happening! Why do I feel so light? Wait a second, it's not the
    air. It\u2019s me. I\u2019m\u2026 a scribble. Just a faint, shaky line \u2014
    a shadow of who I was."
  - I have to find a way out and return back to normal.
  typingSpeed: 0.02
  fadeDuration: 0.5
  holdDuration: 2.5
